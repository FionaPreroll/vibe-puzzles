{
	"name": "vibe-puzzles",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@12.10.1",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p worker --noEmit && tsc -p src/service-worker",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "vitest --run",
		"test:coverage": "vitest --run --coverage",
		"test:e2e": "playwright test",
		"cf:dev": "pnpm build && wrangler d1 migrations apply DB --local && wrangler dev",
		"cf:deploy": "pnpm build && wrangler d1 migrations apply DB --remote && wrangler deploy",
		"bank:grow": "tsx scripts/grow-puzzle-bank.ts",
		"bank:regrade": "tsx scripts/regrade-puzzle-bank.ts",
		"test:server": "playwright test -c playwright.server.config.ts",
		"test:soak": "playwright test -c playwright.load.config.ts soak",
		"test:perf": "vitest --run -c vitest.perf.config.ts && playwright test -c playwright.load.config.ts performance"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20261007.1",
		"@eslint/js": "^10.0.1",
		"@fontsource/cinzel": "^5.3.0",
		"@fontsource/fredoka": "^5.3.0",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^22",
		"@vitest/coverage-v8": "^4.1.11",
		"ajv": "^8.20.0",
		"ajv-formats": "^3.0.1",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"fast-check": "^4.10.2",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^4.1.8",
		"wrangler": "^4.148.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
