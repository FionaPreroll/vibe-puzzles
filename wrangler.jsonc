// Optional Cloudflare Workers deployment with the server features (saves, sync, leaderboards).
// See README.md for setup. GitHub Pages deployments do not use this file.
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "vibe-puzzles",
	"main": "worker/index.ts",
	"compatibility_date": "2026-10-01",
	"assets": {
		"directory": "build",
		"binding": "ASSETS",
		"not_found_handling": "404-page",
		"run_worker_first": ["/api/*"]
	},
	"vars": {
		// "true" generates puzzles on the server so ranked players never see the seed. Large
		// puzzles need more CPU time than the Workers free plan allows (see README).
		"SERVER_PUZZLES": "false"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "vibe-puzzles",
			// Replace with the ID printed by `npx wrangler d1 create vibe-puzzles`.
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "migrations"
		}
	]
}
