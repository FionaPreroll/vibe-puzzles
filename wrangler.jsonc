// Optional Cloudflare Workers deployment with the server features (saves, sync, leaderboards).
// See README.md for setup. GitHub Pages deployments do not use this file.
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "vibe-puzzles",
	"main": "worker/index.ts",
	"compatibility_date": "2026-10-01",
	"assets": {
		"directory": "build",
		"binding": "ASSETS",
		"not_found_handling": "404-page",
		"run_worker_first": ["/api/*"]
	},
	// Daily housekeeping: deletes old puzzle tickets (see worker/index.ts).
	"triggers": { "crons": ["23 4 * * *"] },
	"vars": {
		// "true" hands out puzzles from the server so ranked times are measured by the server. The
		// server only uses the pre-generated collection in static/puzzles (see README).
		"SERVER_PUZZLES": "true"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "vibe-puzzles",
			// Replace with the ID printed by `npx wrangler d1 create vibe-puzzles`.
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "migrations"
		}
	]
}
